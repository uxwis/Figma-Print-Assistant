{
  "name": "print-assistant-cn",
  "version": "1.3.0",
  "description": "国内版 Figma 印前助手：CMYK、出血、裁切线、DPI 预检",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "npm run build && powershell -NoProfile -File package.ps1",
    "typecheck": "tsc --noEmit",
    "test:icc": "node test/icc-export.mjs",
    "test:startup": "node test/plugin-startup.mjs",
    "test:sizes": "node test/size-save.mjs",
    "test:geometry": "node test/print-preflight.mjs",
    "test:figma": "node test/icc-figma.mjs",
    "test:marks": "node test/marks-export.mjs",
    "test:vector": "node test/vector-export.mjs",
    "test:browser": "node test/icc-browser.mjs",
    "test": "npm run test:startup && npm run test:sizes && npm run test:geometry && npm run test:figma && npm run test:marks && npm run test:icc && npm run test:vector"
  },
  "dependencies": {
    "lcms-wasm": "1.0.5",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.114.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
